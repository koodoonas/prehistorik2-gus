@ECHO OFF
IF "%ULTRASND%"=="" GOTO NOGUS
IF NOT EXIST PRE2GUS.COM GOTO NOLAUNCH
IF NOT EXIST PRE2SFX.RAW GOTO NOASSET
IF NOT EXIST PRESENTA.MOD GOTO NOASSET
PRE2GUS.COM /T
GOTO END
:NOGUS
ECHO ULTRASND is not set. Initialize the GUS and try again.
GOTO END
:NOLAUNCH
ECHO PRE2GUS.COM is not in the current directory.
GOTO END
:NOASSET
ECHO A required PRE2GUS audio file is missing.
:END

